[user]
	name = Sean Gallagher
	email = sean@gallaghersw.dev

[core]
	editor = emacsclient -a emacs
	# pager = delta
	autocrlf = input

[credential]
	helper = cache

[init]
	defaultBranch = main

[diff]
	colorMoved = default
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true

[interactive]
	# diffFilter = delta --color-only

# [delta]
# 	navigate = true
# 	light = false
# 	theme = Gruvbox Dark
# 	line-numbers = true
# 	true-color = always
# 	side-by-side = true

[merge]
	conflictStyle = diff3

[alias]
  dt = difftool
[gui]
	fontui = -family \"Fira Sans\" -size 10 -weight normal -slant roman -underline 0 -overstrike 0
	fontdiff = -family \"FiraCode Nerd Font\" -size 10 -weight normal -slant roman -underline 0 -overstrike 0
