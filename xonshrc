from datetime import datetime as dt
from json import loads, dumps
from pathlib import Path

from rich import inspect, get_console

def rp(*args, **kwargs):
    """Print to the rich console."""
    try:
        get_console().print(*args, **kwargs)
    except Exception:
        get_console().print_exception(show_locals=True)

def jls(jstring):
    """Load a JSON string."""
    return loads(jstring)

def jlf(jfile):
    """Load a JSON file."""
    if isinstance(jfile, str):
        jfile = pf"{jfile}"
    return loads(jfile.read_text())

def jds(data):
    """Dump a JSON string."""
    return dumps(data)

def jdf(data, jfile):
    """Dump a JSON file."""
    if isinstance(jfile, str):
        jfile = pf"{jfile}"
    jfile.write_text(dumps(data))

def rinse(obj):
    """Dump an object through rich's inspect."""
    with get_console().pager(styles=True):
        inspect(obj, console=get_console)

